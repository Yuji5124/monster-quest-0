{
  "name": "mq0-trailer-30s-first-half",
  "version": "0.1.0",
  "private": true,
  "description": "モンスタークエスト0 前半30秒予告（Remotion）。ゲーム本体とは独立したプロジェクト。",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:16x9": "remotion render Trailer16x9 out/mq0_trailer_first_half_16x9.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=320k",
    "render:9x16": "remotion render Trailer9x16 out/mq0_trailer_first_half_9x16.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=320k"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/media": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "playwright": "^1.63.0",
    "typescript": "5.9.3"
  }
}
